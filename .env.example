ENVIRONMENT=development
DRY_RUN=true

DATABASE_URL=postgresql+asyncpg://job_agent:job_agent@localhost:5432/job_agent

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_DEFAULT=120/minute

JOB_TITLES=ML Engineer,Data Scientist,Software Engineer
JOB_LOCATIONS=Bangalore,Remote
SCRAPER_SITES=linkedin,indeed,glassdoor
MAX_JOBS_PER_RUN=100
SCRAPER_RESULTS_WANTED=50
SCRAPER_HOURS_OLD=168
INDEED_COUNTRY=india

LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAX_EMAILS_PER_DAY=10

FRONTEND_URL=http://localhost:3000
AUTOFILL_API_BASE_URL=http://localhost:8000
AUTOFILL_WEBHOOK_URL=
AUTOFILL_HEADLESS=false
AUTOFILL_CONFIRM_TIMEOUT_SECONDS=1800
AUTOFILL_POLL_SECONDS=5

SENTRY_DSN=

# ── Frontend / Auth.js ─────────────────────────────────────────────────
# These live in frontend/.env.local for local dev (Next.js reads that file).
# Full setup walkthrough: docs/AUTHENTICATION.md
#
# AUTH_SECRET=            # openssl rand -base64 32
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_ENFORCED=false     # "true" requires login for console pages
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1